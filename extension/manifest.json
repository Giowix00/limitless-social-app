{
  "manifest_version": 3,
  "name": "Locked In",
  "version": "0.1.0",
  "description": "Focus accountability for the First Line team (Discord + camera + Telegram alerts).",
  "permissions": ["storage", "alarms", "offscreen", "declarativeNetRequest", "notifications", "tabs"],
  "host_permissions": ["https://discord.com/*", "https://api.telegram.org/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://discord.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Locked In" },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
